    {
      "parameters": {
        "jsCode": "// Ambil konten sebelumnya dan buat prompt revisi\nlet prevContent = {};\ntry { prevContent = $('Code: Parse Konten').first().json; } catch(e) {}\n\n// Ambil catatan revisi dari query params webhook\nconst waitData = $input.first().json;\nlet revisionNote = 'Perlu perbaikan umum, buat lebih menarik dan engaging';\nif (waitData.query && waitData.query.note) {\n  revisionNote = decodeURIComponent(String(waitData.query.note).replace(/\\+/g, ' '));\n}\n\nconst prompt = `Revisi konten social media berikut sesuai catatan reviewer.\n\nKONTEN SAAT INI:\n\nINSTAGRAM:\n${prevContent.instagram_text || '[tidak tersedia]'}\n\nLINKEDIN:\n${prevContent.linkedin_text || '[tidak tersedia]'}\n\nFACEBOOK:\n${prevContent.facebook_text || '[tidak tersedia]'}\n\nCATATAN REVISI DARI REVIEWER:\n${revisionNote}\n\nInstruksi: Perbaiki berdasarkan catatan. Pertahankan topik dan nada yang sama.\n\nOutput HANYA JSON valid tanpa teks lain:\n{\n  \"instagram\": \"caption instagram yang sudah direvisi\",\n  \"linkedin\": \"post linkedin yang sudah direvisi\",\n  \"facebook\": \"post facebook yang sudah direvisi\",\n  \"image_prompt\": \"updated visual description in English\"\n}`;\n\nreturn [{\n  json: {\n    prompt,\n    topic:          prevContent.topic          || 'Topik',\n    tone:           prevContent.tone           || 'informatif',\n    approval_id:    prevContent.approval_id    || String(Date.now()),\n    approver_email: prevContent.approver_email || 'approver@email.com',\n    report_email:   prevContent.report_email   || 'tim@email.com',\n    revision_note:  revisionNote,\n    revision_count: (prevContent.revision_count || 0) + 1\n  }\n}];"
      },
      "id": "65f927c5-e010-4069-953e-f0c6b0942e77",
      "name": "Code: Prepare Revision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2380,
        740
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\": \"gpt-4o-mini\", \"messages\": [{\"role\": \"system\", \"content\": \"Kamu adalah social media copywriter profesional Indonesia. Revisi konten sesuai instruksi. Output HANYA JSON.\"}, {\"role\": \"user\", \"content\": \"={{ $json.prompt }}\"}], \"max_tokens\": 1800, \"temperature\": 0.8}",
        "options": {
          "retry": {
            "enabled": true,
            "maxTries": 3,
            "waitBetweenTries": 5000
          },
          "response": {
            "response": {
              "responseFormat": "json"
