    {
      "parameters": {
        "jsCode": "// Build prompt untuk OpenAI\nconst d = $('Set Variables').first().json;\nconst topic = d.topic || 'Tips produktivitas';\nconst tone  = d.tone  || 'informatif';\n\nconst prompt = `Kamu adalah social media copywriter profesional untuk brand Indonesia.\n\nBuat konten social media tentang: ${topic}\nNada tulisan: ${tone}\nTarget audiens: profesional muda Indonesia usia 25-35 tahun\n\nAturan:\n- Instagram: maks 2200 karakter, 3-5 emoji, 8-10 hashtag campuran besar & kecil\n- LinkedIn: maks 1300 karakter, profesional, awali dengan hook kuat (statistik/pertanyaan), minimal hashtag\n- Facebook: maks 500 karakter, conversational, akhiri dengan pertanyaan untuk engagement\n\nPENTING: Output HANYA JSON valid, tanpa markdown, tanpa teks lain:\n{\n  \"instagram\": \"full caption instagram disini\",\n  \"linkedin\": \"full post linkedin disini\",\n  \"facebook\": \"full post facebook disini\",\n  \"image_prompt\": \"visual description for designer in English\"\n}`;\n\nreturn [{ json: { ...d, prompt } }];"
      },
      "id": "a6627fda-69ad-465c-a5c4-35e18a0dc570",
      "name": "Code: Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\": \"gpt-4o-mini\", \"messages\": [{\"role\": \"system\", \"content\": \"Kamu adalah social media copywriter profesional Indonesia. Selalu output HANYA JSON yang diminta, tanpa teks tambahan.\"}, {\"role\": \"user\", \"content\": \"={{ $json.prompt }}\"}], \"max_tokens\": 1800, \"temperature\": 0.75}",
        "options": {
          "retry": {
            "enabled": true,
            "maxTries": 3,
            "waitBetweenTries": 5000
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "d326c3c3-bf84-4acd-a394-b323dbae154a",
      "name": "HTTP: OpenAI Generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        420
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "721bf2b4-9287-4ad3-b832-f8ab3291d763",
              "name": "choices",
              "value": "=[{\"message\":{\"content\":\"{\\\"instagram\\\": \\\"[GANTI] Caption Instagram kamu disini. Tambahkan emoji dan hashtag yang relevan #tips #produktivitas\\\",\\\"linkedin\\\": \\\"[GANTI] Post LinkedIn kamu disini. Buat profesional dan tambahkan insight menarik.\\\",\\\"facebook\\\": \\\"[GANTI] Post Facebook kamu disini. Tambahkan pertanyaan di akhir untuk engagement!\\\",\\\"image_prompt\\\": \\\"[GANTI] Deskripsi gambar untuk desainer dalam Bahasa Inggris\\\"}\"}}]",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "7cbd747b-b0e9-490a-928b-09dbf7097135",
      "name": "Set: Manual Content",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        940,
        700
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse output dari OpenAI menjadi struktur standar\nconst item = $input.first().json;\nlet rawContent;\n\n// Tangani berbagai format response\nif (item.choices && item.choices[0] && item.choices[0].message) {\n  rawContent = item.choices[0].message.content;\n} else if (item.content) {\n  rawContent = typeof item.content === 'string' ? item.content : JSON.stringify(item.content);\n} else {\n  rawContent = JSON.stringify(item);\n}\n\n// Parse JSON dari response\nlet content;\ntry {\n  content = JSON.parse(rawContent);\n} catch(e1) {\n  try {\n    const m = rawContent.match(/\\{[\\s\\S]*\\}/);\n    if (!m) throw new Error('No JSON block found');\n    content = JSON.parse(m[0]);\n  } catch(e2) {\n    throw new Error('Gagal parse konten AI. Cek format prompt. Response: ' + rawContent.substring(0, 300));\n  }\n}\n\n// Ambil variabel dari Set Variables\nlet vars = {};\ntry { vars = $('Set Variables').first().json; } catch(e) {}\n\nreturn [{\n  json: {\n    topic:          vars.topic          || 'Topik Konten',\n    tone:           vars.tone           || 'informatif',\n    approval_id:    vars.approval_id    || String(Date.now()),\n    approver_email: vars.approver_email || 'approver@email.com',\n    report_email:   vars.report_email   || 'tim@email.com',\n    instagram_text: content.instagram   || '',\n    linkedin_text:  content.linkedin    || '',\n    facebook_text:  content.facebook    || '',\n    image_prompt:   content.image_prompt|| '',\n    generated_at:   new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }),\n    status:         'pending_approval',\n    revision_count: 0\n  }\n}];"
      },
      "id": "87878856-6d63-45a1-96fd-42f651e61c73",
      "name": "Code: Parse Konten",
      "type": "n8n-nodes-base.code",
