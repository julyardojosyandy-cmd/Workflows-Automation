    {
      "parameters": {
        "sendTo": "={{ $json.approver_email }}",
        "subject": "=[REVIEW] Konten Social Media: {{ $json.topic }} | ID: {{ $json.approval_id }}",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:620px;margin:0 auto;border:1px solid #e2e8f0;border-radius:10px;overflow:hidden\">\n<div style=\"background:linear-gradient(135deg,#1e40af,#3b82f6);color:white;padding:24px 20px\">\n<h2 style=\"margin:0;font-size:20px;font-weight:700\">&#128203; Review Konten Social Media</h2>\n<p style=\"margin:6px 0 0;opacity:0.85;font-size:13px\">Persetujuan diperlukan sebelum konten dipublish ke semua platform</p>\n</div>\n<div style=\"padding:16px 20px;background:#f8fafc;border-bottom:1px solid #e2e8f0;font-size:13px\">\n<table style=\"width:100%;border-collapse:collapse\">\n<tr><td style=\"padding:3px 12px 3px 0;color:#64748b;width:100px\">Topik</td><td><strong>{{ $json.topic }}</strong></td></tr>\n<tr><td style=\"padding:3px 12px 3px 0;color:#64748b\">Approval ID</td><td style=\"font-family:monospace;font-size:11px\">{{ $json.approval_id }}</td></tr>\n<tr><td style=\"padding:3px 12px 3px 0;color:#64748b\">Dibuat</td><td>{{ $json.generated_at }}</td></tr>\n<tr><td style=\"padding:3px 12px 3px 0;color:#64748b\">Revisi ke</td><td>{{ $json.revision_count }}</td></tr>\n</table>\n</div>\n<div style=\"padding:20px\">\n<div style=\"margin-bottom:18px\">\n<div style=\"font-weight:700;color:#e1306c;margin-bottom:8px;display:flex;align-items:center\">&#128247; Instagram</div>\n<div style=\"background:#fff8f9;border:1px solid #fca5a5;border-radius:8px;padding:14px;font-size:13px;line-height:1.6;white-space:pre-wrap;color:#1e293b\">{{ $json.instagram_text }}</div>\n</div>\n<div style=\"margin-bottom:18px\">\n<div style=\"font-weight:700;color:#0077b5;margin-bottom:8px\">&#128101; LinkedIn</div>\n<div style=\"background:#f0f7ff;border:1px solid #93c5fd;border-radius:8px;padding:14px;font-size:13px;line-height:1.6;white-space:pre-wrap;color:#1e293b\">{{ $json.linkedin_text }}</div>\n</div>\n<div style=\"margin-bottom:18px\">\n<div style=\"font-weight:700;color:#1877f2;margin-bottom:8px\">&#128172; Facebook</div>\n<div style=\"background:#eff6ff;border:1px solid #a5b4fc;border-radius:8px;padding:14px;font-size:13px;line-height:1.6;white-space:pre-wrap;color:#1e293b\">{{ $json.facebook_text }}</div>\n</div>\n</div>\n<div style=\"padding:20px;background:#f1f5f9;border-top:1px solid #e2e8f0;text-align:center\">\n<p style=\"margin:0 0 14px;color:#475569;font-size:13px;font-weight:600\">Pilih tindakan untuk konten ini:</p>\n<a href=\"{{ $resumeWebhookUrl }}?status=approved\" style=\"display:inline-block;background:#16a34a;color:white;padding:13px 28px;text-decoration:none;border-radius:8px;font-weight:700;font-size:14px;margin:4px 6px;letter-spacing:0.3px\">&#10003; SETUJU &amp; PUBLISH</a>\n<a href=\"{{ $resumeWebhookUrl }}?status=revise&amp;revision_mode=ai&amp;note=Perlu+diperbaiki+dan+lebih+menarik\" style=\"display:inline-block;background:#dc2626;color:white;padding:13px 28px;text-decoration:none;border-radius:8px;font-weight:700;font-size:14px;margin:4px 6px;letter-spacing:0.3px\">&#9998; PERLU REVISI</a>\n<p style=\"margin:14px 0 0;color:#94a3b8;font-size:11px\">Link otomatis kadaluarsa dalam 3 hari &bull; Jangan forward email ini &bull; Workflow ID: {{ $execution.id }}</p>\n</div>\n</div>",
        "options": {
          "appendAttribution": false
        }
      },
