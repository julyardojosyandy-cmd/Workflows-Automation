      "id": "7e20be06-9d42-4700-9d0a-b21d0ddca950",
      "name": "HTTP: OpenAI Revise",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2620,
        740
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse hasil revisi dari OpenAI\nconst item = $input.first().json;\nlet rawContent;\n\nif (item.choices && item.choices[0] && item.choices[0].message) {\n  rawContent = item.choices[0].message.content;\n} else {\n  rawContent = JSON.stringify(item);\n}\n\nlet content;\ntry {\n  content = JSON.parse(rawContent);\n} catch(e) {\n  const m = rawContent.match(/\\{[\\s\\S]*\\}/);\n  if (!m) throw new Error('No JSON in revision: ' + rawContent.substring(0, 200));\n  content = JSON.parse(m[0]);\n}\n\nlet prepData = {};\ntry { prepData = $('Code: Prepare Revision').first().json; } catch(e) {}\n\nreturn [{\n  json: {\n    topic:          prepData.topic          || 'Topik',\n    tone:           prepData.tone           || 'informatif',\n    approval_id:    prepData.approval_id    || String(Date.now()),\n    approver_email: prepData.approver_email || 'approver@email.com',\n    report_email:   prepData.report_email   || 'tim@email.com',\n    instagram_text: content.instagram       || '',\n    linkedin_text:  content.linkedin        || '',\n    facebook_text:  content.facebook        || '',\n    image_prompt:   content.image_prompt    || '',\n    generated_at:   new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }),\n    status:         'pending_approval_revision',\n    revision_count: prepData.revision_count || 1,\n    revision_note:  prepData.revision_note  || ''\n  }\n}];"
      },
