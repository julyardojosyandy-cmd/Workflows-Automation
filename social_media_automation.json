    {
      "parameters": {
        "jsCode": "// Ambil konten final (revisi atau original)\nlet content = null;\n\n// Coba konten revisi terlebih dahulu\ntry {\n  const rev = $('Code: Parse Revision').first().json;\n  if (rev && rev.instagram_text && rev.instagram_text.length > 5) {\n    content = rev;\n  }\n} catch(e) { /* Revisi tidak berjalan, gunakan original */ }\n\n// Fallback ke konten original\nif (!content) {\n  try {\n    content = $('Code: Parse Konten').first().json;\n  } catch(e) {\n    throw new Error('Tidak dapat menemukan konten untuk dipublish. Pastikan workflow berjalan dengan benar.');\n  }\n}\n\n// ⚠️ GANTI image_url dengan URL gambar asli kamu\n// Opsi 1: URL statis yang kamu generate dari Canva/tools lain\n// Opsi 2: Tambahkan node generate gambar (DALL-E, Stability AI) sebelum node ini\nconst imageUrl = 'https://via.placeholder.com/1080x1080/4F46E5/FFFFFF?text=' + \n                 encodeURIComponent((content.topic || 'Content').substring(0, 20));\n\nreturn [{\n  json: {\n    ...content,\n    image_url:      imageUrl,\n    publish_source: (content.revision_count || 0) > 0 ? 'revised' : 'original',\n    publish_time:   new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' })\n  }\n}];"
      },
